{
  "expo": {
    "name": "SADA POS",
    "slug": "sada-pos",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "sadapos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0047A1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sada.pos"
    },
    "android": {
      "package": "com.sada.pos",
      "adaptiveIcon": {
        "backgroundColor": "#0047A1"
      },
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "./plugins/withBluetoothPermissions",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SADA POS to access your photos to set menu item images."
        }
      ]
    ]
  }
}
