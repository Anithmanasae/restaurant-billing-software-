rules_version = '2';

// Menu item images: readable by anyone signed in, writable by admins only.
// Enforce image content type and a 5MB size cap.
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{restaurantId}/menu/{itemId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
