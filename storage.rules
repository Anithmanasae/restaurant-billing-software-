rules_version = '2';

// Menu item images: readable and writable by anyone signed in (menu edits are
// role-gated in Firestore rules). Enforce image content type and a 5MB cap.
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{restaurantId}/menu/{itemId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
