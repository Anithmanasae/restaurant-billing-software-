# Firebase web app config — copy to `.env.local` and fill from
# Firebase console > Project settings > General > Your apps > Web app.
# These are client-side identifiers (safe to ship); real protection comes
# from Firestore Security Rules + Firebase Auth + App Check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The single restaurant/tenant this deployment serves.
VITE_RESTAURANT_ID=sada-main

# Set to "true" to point the app at local Firebase emulators.
VITE_USE_EMULATORS=false
